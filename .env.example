# NOTE: this server does NOT auto-load a .env file (it has zero dependencies).
# These are the variables it reads from the environment. The normal way to set
# them is the "env" block of the server entry in your MCP config
# (e.g. ~/.claude/mcp.json), not a .env file. This file is just a reference.
#
# You only need the key for the provider(s) you use.

DEEPSEEK_API_KEY=sk-your-key-here            # https://platform.deepseek.com/api_keys
# MOONSHOT_API_KEY=sk-...                    # https://platform.moonshot.ai
# ZAI_API_KEY=...                            # https://z.ai/model-api
# ZHIPU_API_KEY=...                          # https://open.bigmodel.cn
# ALIBABA_SINGAPORE_API_KEY=sk-...           # https://modelstudio.console.alibabacloud.com
# GROQ_API_KEY=gsk_...                       # https://console.groq.com/keys
# XAI_API_KEY=xai-...                        # https://console.x.ai
# OPENROUTER_API_KEY=sk-or-...               # https://openrouter.ai/keys

# DELEGATOR_CONFIG=~/.claude/delegator.json  # config file location
# DELEGATOR_TIMEOUT=120000                   # request timeout, ms (DEEPSEEK_TIMEOUT also honored)
# DELEGATOR_MAX_RETRIES=2                    # retries on 429/5xx (DEEPSEEK_MAX_RETRIES also honored)
# DEEPSEEK_API_HOST=api.deepseek.com         # v2 compat: DeepSeek hostname override
