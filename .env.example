# NOTE: this server does NOT auto-load a .env file (it has zero dependencies).
# These are the variables it reads from the environment. The normal way to set
# them is the "env" block of the server entry in your MCP config
# (e.g. ~/.claude/mcp.json), not a .env file. This file is just a reference.

DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_API_HOST=api.deepseek.com
# DEEPSEEK_TIMEOUT=120000
# DEEPSEEK_MAX_RETRIES=2
