{
  "name": "claude-code-deepseek-delegator",
  "version": "3.0.0",
  "description": "MCP server that lets Claude Code delegate heavy-token tasks to DeepSeek, Kimi, GLM, Qwen, Grok, or any OpenAI-compatible model. Claude orchestrates; the delegate does the heavy lifting. Zero dependencies.",
  "type": "module",
  "bin": {
    "claude-code-deepseek-delegator": "src/index.mjs"
  },
  "files": [
    "src/",
    "DELEGATION.md",
    ".env.example",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "deepseek",
    "claude-code",
    "claude",
    "delegation",
    "orchestration",
    "token-optimization",
    "cost-savings",
    "model-context-protocol",
    "model-agnostic",
    "openrouter",
    "kimi",
    "glm",
    "qwen",
    "providers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12122J/claude-delegator-deepseek-mcp.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
